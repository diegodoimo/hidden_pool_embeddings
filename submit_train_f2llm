#!/bin/bash
#SBATCH --partition=H100
##SBATCH --partition=DGX
#SBATCH --account=lade
##SBATCH --nodelist=dgx003
#SBATCH --nodes=1
#SBATCH --time=48:00:00            
#SBATCH --ntasks-per-node=1       
#SBATCH --cpus-per-task=112           
#SBATCH --mem=800G                   
#SBATCH --job-name=test
#SBATCH --gres=gpu:H100:8

#source /u/area/ddoimo/anaconda3/bin/activate ./env_a100
module load cuda/12.8 
export CUDA_HOME=$CUDA_PATH

source /u/area/ddoimo/anaconda3/bin/activate ./env_h100 

export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True" 


GPU_NUMBER=$(echo $CUDA_VISIBLE_DEVICES | tr ',' ' ' | wc -w)
export WORKERS_PER_RANK=$(( SLURM_CPUS_PER_TASK / GPU_NUMBER ))

#the threads are multiplied by the number of processes we need to scale them down 
export OMP_NUM_THREADS=$WORKERS_PER_RANK
export NUMEXPR_MAX_THREADS=$WORKERS_PER_RANK
export OPENBLAS_NUM_THREADS=$WORKERS_PER_RANK   
export MKL_NUM_THREADS=$WORKERS_PER_RANK         

export PYTHONUNBUFFERED=1
#export TRANSFORMERS_OFFLINE=1
export HF_HOME=/orfeo/cephfs/scratch/area/ddoimo/models

nodes=( $( scontrol show hostnames $SLURM_JOB_NODELIST ) )
head_node=${nodes[0]}
head_node_ip=$(getent hosts "$head_node" | awk '{ print $1 }')


# ---------------------------------------------------------------------------
# F2LLM training with Qwen3-Embedding-0.6B
#
# Hyperparameters from CodeFuse-Embeddings/F2LLM/configs/config.json (4B run),
# adapted for the 0.6B model size:
#   - per_device_train_batch_size: 16   (original: 16)
#   - max_seq_len:                 1024 (original: 1024)
#   - learning_rate:               8e-6 (original: 8e-6)
#   - lr_min_fact:                 0.0125  ≈ min_lr / lr = 1e-7 / 8e-6
#   - weight_decay:                0.01 (original: 0.01)
#   - warmup_steps:                500  (original: 500)
#   - num_train_epochs:            2    (original: 2)
#   - num_hard_negatives:          7    (original: 7)
#   - loss_type:                   f2llm (inbatch NCE + hard-neg NCE)
#   - f2llm_temperature:           0.05 (original: 0.05)
#   - batch_strategy:              f2llm_multi (per-dataset loaders,
#                                  weighted-random sampling, binary
#                                  classification uses 1 negative,
#                                  retrieval adds in-batch loss)
#   - clip_grad_thresh:            1.0  (original DeepSpeed: 1.0)
#
# NOTE on optimizer betas: F2LLM uses (0.9, 0.98); train.py currently
# hard-codes (0.9, 0.999).  If exact reproduction is needed, edit
# utils/optimizer.py to accept a --betas argument.
# ---------------------------------------------------------------------------

#--model_name_or_path Qwen/Qwen3-Embedding-0.6B \
torchrun \
    --nnodes=$SLURM_NTASKS \
    --node-rank=$SLURM_NODEID \
    --nproc-per-node=$GPU_NUMBER \
    --rdzv-id=$SLURM_PROCID \
    --rdzv-backend=c10d \
    --rdzv-endpoint=$head_node:0 \
    train.py \
    --model_name_or_path google/t5gemma-2-270m-270m  \
    --out_filename f2llm_t5gemma-2 \
    --negatives_dir results/datasets_tokenized/f2llm/qwen3_600m-teacher_embeddinggemma-prompt_t5gemma-2-tok \
    --loss_type f2llm \
    --f2llm_temperature 0.05 \
    --batch_strategy f2llm_multi \
    --length_strategy truncate \
    --max_seq_len 1024 \
    --num_hard_negatives 7 \
    --eval_set mteb_eng_v2_reduced \
    --num_workers $WORKERS_PER_RANK \
    --per_device_train_batch_size 16 \
    --per_device_eval_batch_size 128 \
    --learning_rate 8e-6 \
    --lr_min_fact 0.0125 \
    --warmup_steps 500 \
    --weight_decay 0.01 \
    --clip_grad_thresh 1.0 \
    --num_train_epochs 2 \
    --checkpointing_steps 100 \
    --logging_steps 100 \
    --eval_steps 5 \
    --output_dir "./results/train" \
|| true

torchrun \
    --nnodes=$SLURM_NTASKS \
    --node-rank=$SLURM_NODEID \
    --nproc-per-node=$GPU_NUMBER \
    --rdzv-id=$SLURM_PROCID \
    --rdzv-backend=c10d \
    --rdzv-endpoint=$head_node:0 \
    filler.py
